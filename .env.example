# Gripharma — variáveis de ambiente do servidor (copiar para .env e preencher)
# NUNCA cometer o .env com valores reais.

# Porta (opcional)
PORT=3000

# ---- Easypay (pagamentos MB WAY / Referência Multibanco) ----
# Obtém em https://www.easypay.pt (Conta → Integrações/API)
EASYPAY_ACCOUNT_ID=
EASYPAY_API_KEY=
# 'test' (sandbox) ou 'production'
EASYPAY_ENV=test
# E-mail por defeito para os pagamentos quando o cliente não tem e-mail (ex.: o da farmácia)
EASYPAY_DEFAULT_EMAIL=
# Segredo opcional para validar o webhook (?secret=...)
EASYPAY_WEBHOOK_SECRET=
